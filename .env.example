OLE_URL=https://iole.hkmu.edu.hk
STUDENT_ID=your_student_id_here
STUDENT_PASSWORD=your_password_here
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook_url_here
# Time to run daily (24-hour zero-padded HH:MM). Keep comments on their own
# line: docker --env-file passes inline comments through as part of the value.
SCHEDULE_TIME=03:00
TZ=Asia/Hong_Kong
