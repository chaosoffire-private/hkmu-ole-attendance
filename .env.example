# --- Authentication (choose one) -------------------------------------------

# Recommended: paste the whole Cookie request header from a logged-in browser.
# Takes precedence over STUDENT_ID / STUDENT_PASSWORD when set.
SESSION_COOKIE=

# Alternative: drive the SSO login chain. Both must be set to be used.
STUDENT_ID=
STUDENT_PASSWORD=

# --- Notifications ---------------------------------------------------------

# Discord webhook URL. If empty, notifications are written to the log instead.
DISCORD_WEBHOOK=

# --- Scheduling ------------------------------------------------------------

# Time of the daily setup run, as HH:MM.
# Keep comments on their own line: docker --env-file passes inline comments
# through as part of the value.
SCHEDULE_TIME=03:00

# Timezone for scheduling and class times. Defaults to Asia/Hong_Kong.
TIMEZONE=Asia/Hong_Kong

# --- Advanced --------------------------------------------------------------

# OLE portal base URL.
# OLE_URL=https://iole.hkmu.edu.hk

# Endpoints overridden only for testing; the defaults are the live HKMU hosts.
# NAM_LOGIN_URL=https://auth.hkmu.edu.hk/nidp/app/login?sid=0&sid=0
# OLECONNECT_API_URL=https://oleconnect.hkmu.edu.hk/oledb/api/getTodayClass/

# Log filter, e.g. debug.
# RUST_LOG=info
